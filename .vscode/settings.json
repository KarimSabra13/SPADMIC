{
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.rootFile.useSubFile": false,
  "latex-workshop.latex.recipes": [
    {
      "name": "SPADMIC report (MiKTeX, no WSL)",
      "tools": [
        "miktex-pdflatex",
        "miktex-biber",
        "miktex-pdflatex",
        "miktex-pdflatex",
        "copy-spadmic-pdf"
      ]
    },
    {
      "name": "SPADMIC figures only (MiKTeX)",
      "tools": [
        "miktex-pdflatex"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "miktex-pdflatex",
      "command": "C:/Users/Ksabra/AppData/Local/Programs/MiKTeX/miktex/bin/x64/pdflatex.exe",
      "args": [
        "-interaction=nonstopmode",
        "-file-line-error",
        "-halt-on-error",
        "-synctex=1",
        "-output-directory=%OUTDIR%",
        "%DOC%"
      ],
      "env": {
        "MIKTEX_LOG_DIR": "${workspaceFolder}/Rapport_5PSM_KS/build/miktex-log"
      }
    },
    {
      "name": "miktex-biber",
      "command": "C:/Users/Ksabra/AppData/Local/Programs/MiKTeX/miktex/bin/x64/biber.exe",
      "args": [
        "--input-directory",
        "%OUTDIR%",
        "--output-directory",
        "%OUTDIR%",
        "%DOCFILE%"
      ],
      "env": {
        "MIKTEX_LOG_DIR": "${workspaceFolder}/Rapport_5PSM_KS/build/miktex-log"
      }
    },
    {
      "name": "copy-spadmic-pdf",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "New-Item -ItemType Directory -Force -Path '%DIR%/dist' | Out-Null; Copy-Item '%OUTDIR%/%DOCFILE%.pdf' '%DIR%/dist/rapport_5psm.pdf' -Force"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "SPADMIC report (MiKTeX, no WSL)",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.message.error.show": true,
  "latex-workshop.message.warning.show": false
}
