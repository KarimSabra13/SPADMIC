# =============================================================================
# Project  : SPAD_MPTDC — Vernier Time-to-Digital Converter
# File     : mptdc_innovus.mmmc
# Purpose  : Innovus-compatible MMMC view definition for MPTDC digital signoff
# =============================================================================
#
# Genus uses syn/inputs/mptdc.mmmc. Innovus v22.33 on the lab server starts this
# flow in legacy MMMC mode, so this file avoids MMMC2 timing_condition syntax
# and binds library sets directly to delay corners. The active signoff names are
# TC_NOMINAL, WC_SETUP, BC_HOLD, and the report-only RO_MAX_FREQ_STRESS view.
# MPTDC_CLOSURE_SCOPE=TC_ONLY keeps WC_SETUP/BC_HOLD/RO_MAX_FREQ_STRESS defined
# but inactive for today's TC-only physical closure run.
# =============================================================================

proc mptdc_mmmc_env {name default_value} {
    if {[info exists ::env($name)] && $::env($name) ne ""} {
        return $::env($name)
    }
    return $default_value
}

proc mptdc_mmmc_lappend_unique_existing {var_name path label} {
    upvar 1 $var_name paths
    if {$path eq ""} {
        return 0
    }
    if {![file exists $path]} {
        puts "MPTDC_MMMC_WARN: requested $label does not exist: $path"
        return 0
    }
    set normalized [file normalize $path]
    set normalized_existing [list]
    foreach existing $paths {
        if {[file exists $existing]} {
            lappend normalized_existing [file normalize $existing]
        } else {
            lappend normalized_existing $existing
        }
    }
    if {[lsearch -exact $normalized_existing $normalized] >= 0} {
        puts "MPTDC_MMMC_INFO: skipping duplicate $label $normalized"
        return 0
    }
    lappend paths $normalized
    puts "MPTDC_MMMC_INFO: enabling $label $normalized"
    return 1
}

set mptdc_closure_scope [string toupper [mptdc_mmmc_env MPTDC_CLOSURE_SCOPE FULL_MMMC]]

###########################
#    Constraint Modes
###########################
set mptdc_innovus_sdc_files [list $design(postsyn_sdc)]
if {[info exists ::env(MPTDC_OSC_PD_SDC_OVERLAY)] && $::env(MPTDC_OSC_PD_SDC_OVERLAY) ne ""} {
    mptdc_mmmc_lappend_unique_existing mptdc_innovus_sdc_files $::env(MPTDC_OSC_PD_SDC_OVERLAY) "oscillator/PD Innovus SDC overlay"
}

create_constraint_mode \
    -name NOMINAL_FUNCTIONAL \
    -sdc_files $mptdc_innovus_sdc_files

set mptdc_innovus_stress_sdc_files $mptdc_innovus_sdc_files
if {[info exists ::env(MPTDC_RO_STRESS_SDC_OVERLAY)] && $::env(MPTDC_RO_STRESS_SDC_OVERLAY) ne ""} {
    mptdc_mmmc_lappend_unique_existing mptdc_innovus_stress_sdc_files $::env(MPTDC_RO_STRESS_SDC_OVERLAY) "RO stress SDC overlay"
}

create_constraint_mode \
    -name RO_MAX_FREQ_STRESS_MODE \
    -sdc_files $mptdc_innovus_stress_sdc_files

###########################
#    RC Corners
###########################
if {[file exists $tech_files(CAPTABLE_BC)] &&
    [file exists $tech_files(CAPTABLE_TC)] &&
    [file exists $tech_files(CAPTABLE_WC)]} {
    create_rc_corner -name bc_rc \
        -temperature $tech(TEMPERATURE_BC) \
        -cap_table $tech_files(CAPTABLE_BC)

    create_rc_corner -name tc_rc \
        -temperature $tech(TEMPERATURE_TC) \
        -cap_table $tech_files(CAPTABLE_TC)

    create_rc_corner -name wc_rc \
        -temperature $tech(TEMPERATURE_WC) \
        -cap_table $tech_files(CAPTABLE_WC)
} else {
    create_rc_corner -name bc_rc \
        -temperature $tech(TEMPERATURE_BC)

    create_rc_corner -name tc_rc \
        -temperature $tech(TEMPERATURE_TC)

    create_rc_corner -name wc_rc \
        -temperature $tech(TEMPERATURE_WC)
}

###########################
#    Library Sets
###########################
create_library_set -name bc_libset -timing $tech_files(ALL_BC_LIBS)
create_library_set -name tc_libset -timing $tech_files(ALL_TC_LIBS)
create_library_set -name wc_libset -timing $tech_files(ALL_WC_LIBS)

###########################
#    Delay Corners
###########################
create_delay_corner -name bc_corner \
    -library_set bc_libset \
    -rc_corner bc_rc

create_delay_corner -name tc_corner \
    -library_set tc_libset \
    -rc_corner tc_rc

create_delay_corner -name wc_corner \
    -library_set wc_libset \
    -rc_corner wc_rc

###########################
#    Analysis Views
###########################
create_analysis_view -name BC_HOLD \
    -constraint_mode NOMINAL_FUNCTIONAL \
    -delay_corner bc_corner

create_analysis_view -name TC_NOMINAL \
    -constraint_mode NOMINAL_FUNCTIONAL \
    -delay_corner tc_corner

create_analysis_view -name WC_SETUP \
    -constraint_mode NOMINAL_FUNCTIONAL \
    -delay_corner wc_corner

create_analysis_view -name RO_MAX_FREQ_STRESS \
    -constraint_mode RO_MAX_FREQ_STRESS_MODE \
    -delay_corner wc_corner

# Legacy aliases remain for older report-only scripts. New signoff wrappers use
# the purpose-named views above.
create_analysis_view -name bc_view \
    -constraint_mode NOMINAL_FUNCTIONAL \
    -delay_corner bc_corner

create_analysis_view -name tc_view \
    -constraint_mode NOMINAL_FUNCTIONAL \
    -delay_corner tc_corner

create_analysis_view -name wc_view \
    -constraint_mode NOMINAL_FUNCTIONAL \
    -delay_corner wc_corner

if {$mptdc_closure_scope eq "TC_ONLY"} {
    set mptdc_innovus_setup_views [list TC_NOMINAL]
    set mptdc_innovus_hold_views  [list TC_NOMINAL]
    puts "MPTDC_CLOSURE_SCOPE=TC_ONLY"
    puts "SETUP_STATUS_WC=DEFERRED evidence=scope_tc_only"
    puts "HOLD_STATUS_BC=DEFERRED evidence=scope_tc_only"
    puts "RO_1GHZ_STRESS_STATUS=DEFERRED evidence=scope_tc_only"
} else {
    set mptdc_innovus_setup_views [list TC_NOMINAL WC_SETUP]
    set mptdc_innovus_hold_views  [list TC_NOMINAL BC_HOLD]
}

if {[info exists ::env(MPTDC_SIGNOFF_SETUP_VIEWS)] && $::env(MPTDC_SIGNOFF_SETUP_VIEWS) ne ""} {
    set mptdc_innovus_setup_views [split $::env(MPTDC_SIGNOFF_SETUP_VIEWS)]
}
if {[info exists ::env(MPTDC_SIGNOFF_HOLD_VIEWS)] && $::env(MPTDC_SIGNOFF_HOLD_VIEWS) ne ""} {
    set mptdc_innovus_hold_views [split $::env(MPTDC_SIGNOFF_HOLD_VIEWS)]
}

set_analysis_view \
    -setup $mptdc_innovus_setup_views \
    -hold  $mptdc_innovus_hold_views

puts "MPTDC_MMMC_INFO: setup_views=$mptdc_innovus_setup_views"
puts "MPTDC_MMMC_INFO: hold_views=$mptdc_innovus_hold_views"
puts "MPTDC_MMMC_INFO: stress_view=RO_MAX_FREQ_STRESS report_only"
