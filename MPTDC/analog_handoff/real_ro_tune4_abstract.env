# O1 real RO_tune4 abstract source.
# Source this file only on the lab server.

export O1_USE_REAL_RO_ABSTRACT=1
export O1_RO_LIB_NAME=SPADMIC
export O1_RO_CELL_NAME=RO_tune4
export O1_RO_VIEW_NAME=abstract
export O1_RO_LIB_ROOT=/group/validmgr/PROJET/Prj_xh018/spadmic/TOPLEVEL
export O1_RO_ABSTRACT_DIR=/group/validmgr/PROJET/Prj_xh018/spadmic/TOPLEVEL/RO_tune4/abstract
export O1_RO_ABSTRACT_LAYOUT_OA=/group/validmgr/PROJET/Prj_xh018/spadmic/TOPLEVEL/RO_tune4/abstract/layout.oa

# User-provided LEF copied from the analog/Cadence workspace.  This is the
# primary O1A physical macro view source until the OA export path is automated.
export O1_RO_SOURCE_LEF_PATH=/group/validmgr/PROJET/Prj_xh018/ksabra/lef/RO_tune4.lef
export O1_RO_EXTRA_LEF_DIR=/group/validmgr/PROJET/Prj_xh018/ksabra/lef

# If the LEF body still says MACRO RO4_TUNE, the export script may create a
# documented LEF-name alias to RO_tune4.  Geometry and pins are not changed.
export O1_ALLOW_LEF_MACRO_ALIAS=1

# Optional lab-server overrides:
#   O1_RO_LEF_PATH      path to exported/copied RO_tune4 LEF
#   O1_RO_LIBERTY_PATH  path to characterized RO_tune4 Liberty, if available
#   O1_ENABLE_VIRTUOSO_LEF_EXPORT=1 to permit the experimental Virtuoso batch export attempt
