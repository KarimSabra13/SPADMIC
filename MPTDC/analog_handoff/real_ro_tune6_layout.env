# O1 real RO_tune6 layout source.
# Source this file only on the lab server.

export O1_USE_REAL_RO_ABSTRACT=1
export O1_RO_LIB_NAME=SPADMIC
export O1_RO_CELL_NAME=RO_tune6
export O1_RO_VIEW_NAME=layout
export O1_RO_LIB_ROOT=/group/validmgr/PROJET/Prj_xh018/spadmic/TOPLEVEL
export O1_RO_ABSTRACT_DIR=/group/validmgr/PROJET/Prj_xh018/spadmic/TOPLEVEL/RO_tune6/layout
export O1_RO_ABSTRACT_LAYOUT_OA=/group/validmgr/PROJET/Prj_xh018/spadmic/TOPLEVEL/RO_tune6/layout/layout.oa

# User-exported LEF from the analog/Cadence workspace. This is the required
# PnR physical macro view source for the RO_tune6 closure run.
export O1_RO_SOURCE_LEF_PATH=/group/validmgr/PROJET/Prj_xh018/ksabra/lef/RO_tune6.lef
export O1_RO_LEF_PATH=/group/validmgr/PROJET/Prj_xh018/ksabra/lef/RO_tune6.lef
export O1_RO_EXTRA_LEF_DIR=/group/validmgr/PROJET/Prj_xh018/ksabra/lef

# RO_tune6 uses the clean final PnR pin contract:
#   rstb, code[0:7], S[0:7], VDD, VSS
# vdd! is intentionally merged into VDD inside the analog abstract and must not
# be exported or connected as a separate Innovus macro PG pin.
export O1_ALLOW_LEF_MACRO_ALIAS=0

# Liberty is a shell until a characterized RO_tune6 Liberty is delivered.
export O1_RO_LIBERTY_PATH=MPTDC/syn/macros/RO_tune6_real_layout_shell.lib
