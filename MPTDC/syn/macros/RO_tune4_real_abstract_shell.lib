/*
 * RO_tune4 Liberty shell for O1C macro binding.
 *
 * Status:
 *   REAL PHYSICAL LEF AVAILABLE
 *   LIBERTY SHELL ONLY
 *   NO ANALOG STARTUP SIGNOFF
 *   NO JITTER SIGNOFF
 *   NO TAP-DELAY SIGNOFF
 *   NO SLEW/LOAD FINAL SIGNOFF
 *
 * The RO_tune4 phase behavior is modeled in SDC with explicit clocks on S[0:7].
 * This shell exists only to let Genus bind the RTL macro instance to the real
 * LEF master.  It intentionally does not invent combinational timing arcs from
 * rstb/code to S.
 */
library (RO_tune4_real_abstract_shell) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  capacitive_load_unit (1, pf);
  leakage_power_unit : "1nW";
  nom_process : 1.0;
  nom_temperature : 25.0;
  nom_voltage : 1.8;
  voltage_map (VDD, 1.8);
  voltage_map (VSS, 0.0);

  type (ro_tune4_code_bus) {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
    downto : true;
  }

  type (ro_tune4_phase_bus) {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
    downto : true;
  }

  cell (RO_tune4) {
    area : 11869.064;
    cell_leakage_power : 0.0;

    pg_pin (VDD) {
      pg_type : primary_power;
      voltage_name : "VDD";
    }

    pg_pin (VSS) {
      pg_type : primary_ground;
      voltage_name : "VSS";
    }

    pg_pin ("vdd!") {
      pg_type : primary_power;
      voltage_name : "VDD";
    }

    pin (rstb) {
      direction : input;
      capacitance : 0.001;
      related_power_pin : "VDD";
      related_ground_pin : "VSS";
    }

    bus (code) {
      bus_type : ro_tune4_code_bus;
      direction : input;
      capacitance : 0.001;
      related_power_pin : "VDD";
      related_ground_pin : "VSS";
    }

    bus (S) {
      bus_type : ro_tune4_phase_bus;
      direction : output;
      max_capacitance : 0.050;
      related_power_pin : "VDD";
      related_ground_pin : "VSS";
    }
  }
}
