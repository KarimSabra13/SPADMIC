      RECT 0.000 0.000 300.000 100.000 ;
    LAYER MET2 ;
      RECT 4.000 0.000 300.000 100.000 ;
      RECT 0.000 0.000 4.000 46.000 ;
      RECT 0.000 54.000 4.000 100.000 ;
    LAYER MET3 ;
