/*
 * RO_tune4 Liberty shell with a 75.59 fF S-output max-cap limit.
 *
 * EXPERIMENT ONLY:
 *   - Not used by the default O11 report-only flow.
 *   - Not a waiver for measured routed RO output load.
 *   - Use only to test tool sensitivity to the CN/clock-like estimate.
 */
library (RO_tune4_shell_load76ff) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  capacitive_load_unit (1, pf);
  leakage_power_unit : "1nW";
  nom_process : 1.0;
  nom_temperature : 25.0;
  nom_voltage : 1.8;

  type (ro_tune4_code_bus) {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
    downto : true;
  }

  type (ro_tune4_phase_bus) {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
    downto : true;
  }

  cell (RO_tune4) {
    area : 11869.064;
    cell_leakage_power : 0.0;

    pg_pin (VDD) {
      pg_type : primary_power;
      voltage_name : "VDD";
    }

    pg_pin (VSS) {
      pg_type : primary_ground;
      voltage_name : "VSS";
    }

    pg_pin ("vdd!") {
      pg_type : primary_power;
      voltage_name : "VDD";
    }

    pin (rstb) {
      direction : input;
      capacitance : 0.001;
      related_power_pin : "VDD";
      related_ground_pin : "VSS";
    }

    bus (code) {
      bus_type : ro_tune4_code_bus;
      direction : input;
      capacitance : 0.001;
      related_power_pin : "VDD";
      related_ground_pin : "VSS";
    }

    bus (S) {
      bus_type : ro_tune4_phase_bus;
      direction : output;
      max_capacitance : 0.07559;
      related_power_pin : "VDD";
      related_ground_pin : "VSS";
    }
  }
}
