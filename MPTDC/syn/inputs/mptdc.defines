# =============================================================================
# Project  : SPAD_MPTDC — Vernier Time-to-Digital Converter
# File     : mptdc.defines
# Purpose  : Design-specific variables for synthesis and PnR flows
# Author   : Karim Sabra
# =============================================================================
# This file contains ALL design-specific definitions:
#   - Top-level module name
#   - Port/pin definitions (clocks, resets, scan)
#   - SDC constraint parameters
#   - File paths and directory structure
#   - MMMC analysis view selections
#   - Message suppression
#
# Inspired by enics-labs/rtl2gds-demo methodology.
# =============================================================================

#############################################
#       Design Hierarchy
#############################################
set design(TOPLEVEL) "mptdc_axis_core"
set design(FULLCHIP_OR_MACRO) "MACRO"        ;# No IO ring — TDC is a macro block
set design(HAS_SCAN)          "no"           ;# No scan chain in this design

#############################################
#       Technology Selection
#############################################
# These names select which library.<name>.tcl files to source
set TECHNOLOGY     "xh018"            ;# XFAB XH018 180 nm process
set SC_TECHNOLOGY  "xh018-stdcells"   ;# XFAB standard cell library

#############################################
#       Port Definitions (from RTL)
#############################################

# ── Clocks ──────────────────────────────────────────────────────────
# All clocks defined as parallel lists for SDC automation
set design(CLK_NAME) "clk_sys"
    set design(clock_list)      [list $design(CLK_NAME)]
set design(CLK_PORT) "clk_sys"
    set design(clock_port_list) [list $design(CLK_PORT)]
set design(CLK_PERIOD) 6.25              ;# 160 MHz → 6.25 ns
    set design(clock_period_list) [list $design(CLK_PERIOD)]

# ── Oscillator Virtual Clocks ──────────────────────────────────────
# These come from analog macros (current-starved ring oscillators). During
# synthesis the implementation stubs provide controllable placeholder outputs
# so oscillator-domain logic remains present for physical planning.
set design(OSC_SLOW_NAME)   "clk_osc_slow"
set design(OSC_SLOW_PERIOD) 1.0          ;# ~1.0 GHz → 1.0 ns (9 taps × ~111 ps)
set design(OSC_SLOW_PIN)    {u_core/u_osc_slow/u_stub/phase[0]}
set design(OSC_SLOW_TAP_STEP) 0.055      ;# ns — S1..S8 analog tap spacing
set design(OSC_SLOW_TAP_PINS) [list \
    {u_core/u_osc_slow/u_stub/phase[0]} \
    {u_core/u_osc_slow/u_stub/phase[1]} \
    {u_core/u_osc_slow/u_stub/phase[2]} \
    {u_core/u_osc_slow/u_stub/phase[3]} \
    {u_core/u_osc_slow/u_stub/phase[4]} \
    {u_core/u_osc_slow/u_stub/phase[5]} \
    {u_core/u_osc_slow/u_stub/phase[6]} \
    {u_core/u_osc_slow/u_stub/phase[7]} \
]

set design(OSC_FAST_NAME)   "clk_osc_fast"
set design(OSC_FAST_PERIOD) 0.9          ;# ~1.11 GHz → 0.9 ns (9 taps × ~100 ps)
set design(OSC_FAST_PIN)    {u_core/u_osc_fast/u_stub/phase[0]}
set design(OSC_FAST_TAP_STEP) 0.050      ;# ns — F1..F8 analog tap spacing
set design(OSC_FAST_TAP_PINS) [list \
    {u_core/u_osc_fast/u_stub/phase[0]} \
    {u_core/u_osc_fast/u_stub/phase[1]} \
    {u_core/u_osc_fast/u_stub/phase[2]} \
    {u_core/u_osc_fast/u_stub/phase[3]} \
    {u_core/u_osc_fast/u_stub/phase[4]} \
    {u_core/u_osc_fast/u_stub/phase[5]} \
    {u_core/u_osc_fast/u_stub/phase[6]} \
    {u_core/u_osc_fast/u_stub/phase[7]} \
]

# Optional oscillator timing what-if overrides for controlled Genus experiments.
# These alter only the SDC clock/tap model, not RTL constants or packet layout.
foreach {env_name design_key label} [list \
    MPTDC_OSC_SLOW_PERIOD_NS OSC_SLOW_PERIOD slow_period \
    MPTDC_OSC_FAST_PERIOD_NS OSC_FAST_PERIOD fast_period \
    MPTDC_OSC_SLOW_TAP_STEP_NS OSC_SLOW_TAP_STEP slow_tap_step \
    MPTDC_OSC_FAST_TAP_STEP_NS OSC_FAST_TAP_STEP fast_tap_step \
] {
    if {[info exists ::env($env_name)] && $::env($env_name) ne ""} {
        set design($design_key) $::env($env_name)
        puts "MPTDC_DEFINES_INFO: overriding oscillator $label with $::env($env_name) ns from $env_name"
    }
}

set design(OSC_SLOW_ANALOG_PINS) [list start_i {ctrl_i[7:0]} {phase_o[7:0]} VDDA VSSA]
set design(OSC_FAST_ANALOG_PINS) [list stop_i  {ctrl_i[7:0]} {phase_o[7:0]} VDDA VSSA]
set design(OSC_TOPOLOGY) "slow_north_pd_center_fast_south"

# O1C real RO macro-binding mode.  This only changes synthesis/PnR
# timing pin names so clocks attach to the real macro pins.  Simulation keeps
# using the normal wrapper/model path unless explicitly compiled otherwise.
set mptdc_use_real_ro_macro 0
if {[info exists ::env(MPTDC_USE_RO_TUNE6_MACRO)] && $::env(MPTDC_USE_RO_TUNE6_MACRO)} {
    set mptdc_use_real_ro_macro 1
}
if {[info exists ::env(MPTDC_USE_RO_TUNE4_MACRO)] && $::env(MPTDC_USE_RO_TUNE4_MACRO)} {
    set mptdc_use_real_ro_macro 1
}
if {$mptdc_use_real_ro_macro} {
    set design(OSC_SLOW_PIN) {u_core/u_osc_slow/u_ro_tune4/S[0]}
    set design(OSC_SLOW_TAP_PINS) [list \
        {u_core/u_osc_slow/u_ro_tune4/S[0]} \
        {u_core/u_osc_slow/u_ro_tune4/S[1]} \
        {u_core/u_osc_slow/u_ro_tune4/S[2]} \
        {u_core/u_osc_slow/u_ro_tune4/S[3]} \
        {u_core/u_osc_slow/u_ro_tune4/S[4]} \
        {u_core/u_osc_slow/u_ro_tune4/S[5]} \
        {u_core/u_osc_slow/u_ro_tune4/S[6]} \
        {u_core/u_osc_slow/u_ro_tune4/S[7]} \
    ]

    set design(OSC_FAST_PIN) {u_core/u_osc_fast/u_ro_tune4/S[0]}
    set design(OSC_FAST_TAP_PINS) [list \
        {u_core/u_osc_fast/u_ro_tune4/S[0]} \
        {u_core/u_osc_fast/u_ro_tune4/S[1]} \
        {u_core/u_osc_fast/u_ro_tune4/S[2]} \
        {u_core/u_osc_fast/u_ro_tune4/S[3]} \
        {u_core/u_osc_fast/u_ro_tune4/S[4]} \
        {u_core/u_osc_fast/u_ro_tune4/S[5]} \
        {u_core/u_osc_fast/u_ro_tune4/S[6]} \
        {u_core/u_osc_fast/u_ro_tune4/S[7]} \
    ]

    set design(OSC_SLOW_ANALOG_PINS) [list rstb {code[7:0]} {S[7:0]} VDD VSS {vdd!}]
    set design(OSC_FAST_ANALOG_PINS) [list rstb {code[7:0]} {S[7:0]} VDD VSS {vdd!}]
    puts {MPTDC_DEFINES_INFO: O1C real RO macro mode enabled; oscillator tap clocks use u_ro_tune4/S[0:7]}
}

# ── Reset ───────────────────────────────────────────────────────────
set design(RST_PORT) "async_rst_n"       ;# Async active-low reset

# ── Async Inputs (SPAD / Calibration) ──────────────────────────────
set design(ASYNC_INPUTS) [list \
    "start_spad_async_i" \
    "stop_spad_async_i"  \
    "cal_start_async_i"  \
    "cal_stop_async_i"   \
]

#############################################
#       SDC Settings
#############################################
# IO Constraints
# FULLCHIP budgets include pad/package/board assumptions.
# MACRO budgets model an internal on-chip block boundary and are intentionally
# much tighter than the pad-level defaults.
set design(INPUT_DELAY_FULLCHIP)   2.0    ;# ns — pad/package-level assumption
set design(OUTPUT_DELAY_FULLCHIP)  2.0    ;# ns — pad/package-level assumption
set design(OUTPUT_LOAD_FULLCHIP)   0.05   ;# pF — conservative pad load

set design(INPUT_DELAY_MACRO)      0.5    ;# ns — provisional internal interface budget
set design(OUTPUT_DELAY_MACRO)     0.5    ;# ns — provisional internal interface budget
set design(OUTPUT_LOAD_MACRO)      0.01   ;# pF — light on-chip sink estimate

set design(INPUT_TRANSITION)       0.1    ;# ns — max input transition time

# Clock Constraints
set design(CLOCK_UNCERTAINTY)    0.3     ;# ns — jitter + skew budget (180 nm)
set design(CLOCK_TRANSITION)     0.15    ;# ns — max clock edge transition
set design(OSC_CLOCK_UNCERTAINTY) 0.05   ;# ns — oscillator jitter budget
set design(OSC_CLOCK_UNCERTAINTY_SETUP) 0.050 ;# ns — pre-Liberty p-p jitter + skew margin
set design(OSC_CLOCK_UNCERTAINTY_HOLD)  0.020 ;# ns — cycle-edge/local skew placeholder

# Design Rule Constraints
set design(MAX_FANOUT)     20
set design(MAX_TRANSITION) 0.5           ;# ns
set design(RESET_MAX_FANOUT)     32      ;# reset leaf target after hierarchy split
set design(RESET_MAX_TRANSITION) 0.35    ;# ns — keep reset-control slew bounded

# Intentional latches expected in mptdc_async_frontend_v2
# (Used for post-synthesis auditing)
set design(EXPECTED_LATCH_COUNT) 7       ;# start, stop, start_accept_seen, start_reject_seen, active_ctx, ctx_drain×2

#############################################
#       Files and Paths
#############################################
set design(workdir)           [pwd]
set defines_dir               [file dirname [file normalize [info script]]]
set design(syn_root)          [file dirname $defines_dir]
set design(project_root)      [file dirname $design(syn_root)]

# Source directories
set design(rtl_dir)           "$design(project_root)/rtl"
set design(inputs_dir)        $defines_dir
set design(libraries_dir)     "$design(syn_root)/libraries"
set design(scripts_dir)       "$design(syn_root)/scripts"

# Output directories (gitignored)
set design(work_dir)          "$design(syn_root)/work"
set design(export_dir)        "$design(syn_root)/outputs"
set design(reports_dir)       "$design(syn_root)/reports"
set design(logs_dir)          "$design(syn_root)/logs"
set design(synthesis_reports) "$design(reports_dir)/synthesis"

# Stable work/ flow override.
# When set by the server wrapper, all Genus-generated products are written
# below work/genus/<RUN_ID>/ instead of the checked-in source tree.
if {[info exists ::env(MPTDC_GENUS_RUN_DIR)] && $::env(MPTDC_GENUS_RUN_DIR) ne ""} {
    set mptdc_genus_run_dir [file normalize $::env(MPTDC_GENUS_RUN_DIR)]
    set design(work_dir)          "$mptdc_genus_run_dir/internal/work"
    set design(export_dir)        "$mptdc_genus_run_dir/outputs"
    set design(reports_dir)       "$mptdc_genus_run_dir/reports"
    set design(logs_dir)          "$mptdc_genus_run_dir/logs"
    set design(synthesis_reports) "$design(reports_dir)/synthesis"
    puts "MPTDC_DEFINES_INFO: using MPTDC_GENUS_RUN_DIR=$mptdc_genus_run_dir for Genus outputs"
}

# HDL source paths
set design(hdl_search_paths)  [list $design(rtl_dir)]
set design(read_hdl_list)     "$design(syn_root)/filelist_synth.f"
if {[info exists ::env(MPTDC_READ_HDL_LIST)] && $::env(MPTDC_READ_HDL_LIST) ne ""} {
    set design(read_hdl_list) $::env(MPTDC_READ_HDL_LIST)
    puts "MPTDC_DEFINES_INFO: overriding HDL filelist with $design(read_hdl_list)"
}

# SDC and MMMC
set design(functional_sdc)    "$design(inputs_dir)/mptdc.sdc"
set design(mmmc_view_file)    "$design(inputs_dir)/mptdc.mmmc"

# Export file names
set design(postsyn_netlist)   "$design(export_dir)/$design(TOPLEVEL).postsyn.v"
set design(postsyn_sdc)       "$design(export_dir)/$design(TOPLEVEL).postsyn.sdc"
set design(postsyn_sdf)       "$design(export_dir)/$design(TOPLEVEL).postsyn.sdf"
set design(postsyn_db)        "$design(export_dir)/$design(TOPLEVEL).genus_db"

#############################################
#       MMMC Analysis Views
#############################################
set design(selected_setup_analysis_views) "wc_view"
set design(selected_hold_analysis_views)  "bc_view"
if {[info exists ::env(MPTDC_TIMING_VIEW)] && $::env(MPTDC_TIMING_VIEW) eq "tc_only"} {
    set design(selected_setup_analysis_views) "tc_view"
    set design(selected_hold_analysis_views)  "tc_view"
    puts "MPTDC_DEFINES_INFO: selecting TC-only analysis view from MPTDC_TIMING_VIEW=tc_only"
}
if {[info exists ::env(MPTDC_TC_ONLY_VIEW)] && $::env(MPTDC_TC_ONLY_VIEW)} {
    set design(selected_setup_analysis_views) "tc_view"
    set design(selected_hold_analysis_views)  "tc_view"
    puts "MPTDC_DEFINES_INFO: selecting TC-only analysis view from MPTDC_TC_ONLY_VIEW"
}

#############################################
#       Message Suppression
#############################################
# Populate these after reviewing Genus warnings for this specific design.
# Only suppress messages you have explicitly reviewed and deemed safe.
set design(SUPPRESS_MESSAGES_GENUS) [list]

# Expected: CW chipware inference messages
# lappend design(SUPPRESS_MESSAGES_GENUS) "CDFG-760"

#############################################
#       Optional Frequency Mode Overlay
#############################################
# O1B uses this hook to override only the synthesis/PnR timing variables before
# MMMC/SDC files are read.  It does not change RTL packet semantics or the
# calibration field definitions.  The behavioral oscillator model remains
# nominal unless a separate simulation compile mode is explicitly added.
if {[info exists ::env(MPTDC_FREQ_MODE_DEFINES)] && $::env(MPTDC_FREQ_MODE_DEFINES) ne ""} {
    if {[file exists $::env(MPTDC_FREQ_MODE_DEFINES)]} {
        source $::env(MPTDC_FREQ_MODE_DEFINES)
    } else {
        puts "MPTDC_DEFINES_WARN: MPTDC_FREQ_MODE_DEFINES not found: $::env(MPTDC_FREQ_MODE_DEFINES)"
    }
}

#############################################
#       Print values to debug file
#############################################
if {[info exists debug_file]} {
    set fh [open $debug_file a]
    puts $fh "=== mptdc.defines loaded ==="
    puts $fh "  TOPLEVEL:    $design(TOPLEVEL)"
    puts $fh "  CLK_PERIOD:  $design(CLK_PERIOD) ns"
    puts $fh "  TECHNOLOGY:  $TECHNOLOGY"
    close $fh
}
