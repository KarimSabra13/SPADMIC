# =============================================================================
# Project  : SPAD_MPTDC — Vernier Time-to-Digital Converter
# File     : mptdc.mmmc
# Purpose  : Multi-Mode Multi-Corner view definition for Genus / Innovus
# Author   : Karim Sabra
# =============================================================================
# MMMC Hierarchy:
#
#   Analysis View ──┬── Constraint Mode ──→ SDC File
#                   └── Delay Corner ──┬── Timing Condition ──→ Library Set ──→ .lib
#                                      └── RC Corner ──→ QRCTech File
#
# The checked-in defaults now enable BC/TC/WC views. Setup defaults to WC and
# hold defaults to BC via design(selected_*_analysis_views). When the lab QRC
# decks are unavailable, the same views still load with temperature-only RC
# corners so the flow remains portable.
# =============================================================================

###########################
#    Constraint Modes
###########################
set mptdc_functional_sdc_files [list $design(functional_sdc)]
if {[info exists ::env(MPTDC_OSC_PD_SDC_OVERLAY)] && $::env(MPTDC_OSC_PD_SDC_OVERLAY) ne ""} {
    if {[file exists $::env(MPTDC_OSC_PD_SDC_OVERLAY)]} {
        lappend mptdc_functional_sdc_files $::env(MPTDC_OSC_PD_SDC_OVERLAY)
        puts "MPTDC_MMMC_INFO: enabling oscillator/PD SDC overlay $::env(MPTDC_OSC_PD_SDC_OVERLAY)"
    } else {
        puts "MPTDC_MMMC_WARN: requested oscillator/PD SDC overlay does not exist: $::env(MPTDC_OSC_PD_SDC_OVERLAY)"
    }
}

create_constraint_mode \
    -name functional_mode \
    -sdc_files $mptdc_functional_sdc_files

###########################
#    RC Corners
###########################
if {$tech(HAS_QRC_TECH)} {
    create_rc_corner -name bc_rc \
        -temperature $tech(TEMPERATURE_BC) \
        -qrc_tech $tech_files(QRCTECH_BC)

    create_rc_corner -name tc_rc \
        -temperature $tech(TEMPERATURE_TC) \
        -qrc_tech $tech_files(QRCTECH_TC)

    create_rc_corner -name wc_rc \
        -temperature $tech(TEMPERATURE_WC) \
        -qrc_tech $tech_files(QRCTECH_WC)
} else {
    create_rc_corner -name bc_rc \
        -temperature $tech(TEMPERATURE_BC)

    create_rc_corner -name tc_rc \
        -temperature $tech(TEMPERATURE_TC)

    create_rc_corner -name wc_rc \
        -temperature $tech(TEMPERATURE_WC)
}

###########################
#    Library Sets
###########################
# Best-case (fast corner) — for hold analysis
create_library_set -name bc_libset -timing $tech_files(ALL_BC_LIBS)

# Typical corner — useful for correlation and debug
create_library_set -name tc_libset -timing $tech_files(ALL_TC_LIBS)

# Worst-case (slow corner) — for setup analysis
create_library_set -name wc_libset -timing $tech_files(ALL_WC_LIBS)

###########################
#    Timing Conditions
###########################
create_timing_condition -name bc_cond -library_sets bc_libset
create_timing_condition -name tc_cond -library_sets tc_libset
create_timing_condition -name wc_cond -library_sets wc_libset

###########################
#    Delay Corners
###########################
create_delay_corner -name bc_corner \
    -timing_condition bc_cond \
    -rc_corner bc_rc

create_delay_corner -name tc_corner \
    -timing_condition tc_cond \
    -rc_corner tc_rc

create_delay_corner -name wc_corner \
    -timing_condition wc_cond \
    -rc_corner wc_rc

###########################
#    Analysis Views
###########################
create_analysis_view -name bc_view \
    -constraint_mode functional_mode \
    -delay_corner bc_corner

create_analysis_view -name tc_view \
    -constraint_mode functional_mode \
    -delay_corner tc_corner

create_analysis_view -name wc_view \
    -constraint_mode functional_mode \
    -delay_corner wc_corner

###########################
#  Selected Analysis Views
###########################
# Default signoff-oriented selection: WC for setup, BC for hold.
# Override in mptdc.defines if you need tc_view-only bring-up.
set_analysis_view \
    -setup $design(selected_setup_analysis_views) \
    -hold  $design(selected_hold_analysis_views)
