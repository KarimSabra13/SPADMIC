{
  "backend": "streaming",
  "analysis_jobs": 2,
  "chunksize": 200000,
  "max_files": null,
  "max_rows_per_file": null,
  "nfast_encoding": "raw_lfsr_tag",
  "usecols": [
    "conv_id",
    "hit_idx",
    "Tref_ps",
    "nslow",
    "nfast_hit",
    "ns",
    "nf",
    "stop_phase_disc",
    "phase0_snap",
    "slow_boundary_inc",
    "hit_count",
    "flags",
    "ctx_id",
    "t_raw_ps",
    "tuple_code"
  ],
  "dtype_map": {
    "conv_id": "int32",
    "hit_idx": "int16",
    "Tref_ps": "float32",
    "nslow": "int16",
    "nfast_hit": "int16",
    "ns": "int8",
    "nf": "int8",
    "stop_phase_disc": "int8",
    "phase0_snap": "int8",
    "slow_boundary_inc": "int8",
    "hit_count": "int8",
    "flags": "int16",
    "ctx_id": "int8",
    "t_raw_ps": "float32",
    "tuple_code": "int32"
  },
  "notes": [
    "Streaming mode never concatenates the full campaign.",
    "P90/P99 absolute-error tails are histogram approximations.",
    "Raw scatter plots and pairwise t-tests are intentionally skipped in streaming mode."
  ]
}
