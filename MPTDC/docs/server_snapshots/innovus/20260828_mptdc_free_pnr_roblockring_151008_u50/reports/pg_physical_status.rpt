# MPTDC Physical PG Grid Status
POWER_NET=VDD
GROUND_NET=VSS
STDCELL_POWER_PINS=vddi
STDCELL_GROUND_PINS=gndi
RO_POWER_PIN_MAP=VDD->VDD VSS->VSS

COMMAND_ADD_RING=addRing -nets {VDD VSS} -type core_rings -follow core -layer {top MET3 bottom MET3 left METTP right METTP} -width {top 2 bottom 2 left 2 right 2} -spacing {top 1 bottom 1 left 1 right 1} -offset {top 2 bottom 2 left 2 right 2}
ADD_RING_STATUS=PASS

COMMAND_ADD_STRIPE_VERTICAL=addStripe -nets {VDD VSS} -layer METTP -direction vertical -width 2 -spacing 2 -set_to_set_distance 80 -start_from left -start_offset 20 -break_stripes_at_block_rings
ADD_STRIPE_VERTICAL_ATTEMPT_STATUS=FAIL
ADD_STRIPE_VERTICAL_ATTEMPT_ERROR=  
ADD_STRIPE_VERTICAL_STATUS=FAIL

COMMAND_ADD_STRIPE_HORIZONTAL=addStripe -nets {VDD VSS} -layer MET3 -direction horizontal -width 2 -spacing 2 -set_to_set_distance 80 -start_from bottom -start_offset 20 -break_stripes_at_block_rings
ADD_STRIPE_HORIZONTAL_ATTEMPT_STATUS=FAIL
ADD_STRIPE_HORIZONTAL_ATTEMPT_ERROR=  
ADD_STRIPE_HORIZONTAL_STATUS=FAIL
