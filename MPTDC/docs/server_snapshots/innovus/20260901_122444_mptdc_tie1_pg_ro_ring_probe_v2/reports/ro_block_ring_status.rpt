# MPTDC RO Block Ring Status
RO_BLOCK_RING_ENABLE=1
RO_BLOCK_RING_WIDTH_UM=2.0
RO_BLOCK_RING_SPACING_UM=1.0
RO_BLOCK_RING_OFFSET_UM=2.0
RO_BLOCK_RING_INSTANCE_COUNT=2
RO_BLOCK_RING_INSTANCE_SET=u_core_u_osc_fast_u_ro_tune4,u_core_u_osc_slow_u_ro_tune4
RO_BLOCK_RING_VDD_SWIRE_COUNT_PRE=450
RO_BLOCK_RING_VSS_SWIRE_COUNT_PRE=419

RO_BLOCK_RING_1_INSTANCE=u_core_u_osc_fast_u_ro_tune4
RO_BLOCK_RING_1_SELECT_COMMAND=selectInst u_core_u_osc_fast_u_ro_tune4
RO_BLOCK_RING_1_SELECT_STATUS=PASS
RO_BLOCK_RING_1_SELECT_MODE=selectInst

COMMAND_RO_BLOCK_RING_1=addRing -nets {VDD VSS} -type block_rings -around cluster -layer {top MET3 bottom MET3 left METTP right METTP} -width {top 2.0 bottom 2.0 left 2.0 right 2.0} -spacing {top 1.0 bottom 1.0 left 1.0 right 1.0} -offset {top 2.0 bottom 2.0 left 2.0 right 2.0}
RO_BLOCK_RING_1_STATUS=PASS
RO_BLOCK_RING_1_VDD_SWIRE_COUNT_PRE=450
RO_BLOCK_RING_1_VDD_SWIRE_COUNT_POST=455
RO_BLOCK_RING_1_VSS_SWIRE_COUNT_PRE=419
RO_BLOCK_RING_1_VSS_SWIRE_COUNT_POST=423
RO_BLOCK_RING_1_GEOMETRY_EFFECT_STATUS=PASS

RO_BLOCK_RING_2_INSTANCE=u_core_u_osc_slow_u_ro_tune4
RO_BLOCK_RING_2_SELECT_COMMAND=selectInst u_core_u_osc_slow_u_ro_tune4
RO_BLOCK_RING_2_SELECT_STATUS=PASS
RO_BLOCK_RING_2_SELECT_MODE=selectInst

COMMAND_RO_BLOCK_RING_2=addRing -nets {VDD VSS} -type block_rings -around cluster -layer {top MET3 bottom MET3 left METTP right METTP} -width {top 2.0 bottom 2.0 left 2.0 right 2.0} -spacing {top 1.0 bottom 1.0 left 1.0 right 1.0} -offset {top 2.0 bottom 2.0 left 2.0 right 2.0}
RO_BLOCK_RING_2_STATUS=PASS
RO_BLOCK_RING_2_VDD_SWIRE_COUNT_PRE=455
RO_BLOCK_RING_2_VDD_SWIRE_COUNT_POST=460
RO_BLOCK_RING_2_VSS_SWIRE_COUNT_PRE=423
RO_BLOCK_RING_2_VSS_SWIRE_COUNT_POST=427
RO_BLOCK_RING_2_GEOMETRY_EFFECT_STATUS=PASS

RO_BLOCK_RING_CREATED_COUNT=2
RO_BLOCK_RING_VDD_SWIRE_COUNT_POST=460
RO_BLOCK_RING_VSS_SWIRE_COUNT_POST=427
RO_BLOCK_RING_GEOMETRY_EFFECT_STATUS=PASS
RO_BLOCK_RING_STATUS=PASS
