# MPTDC PG isolated candidate
CANDIDATE=core_block_via_closest
MODE_COMMAND=setSrouteMode -viaThruToClosestRing true
SROUTE_COMMAND=sroute -connect {corePin blockPin} -nets {VDD VSS} -blockPin all -blockPinTarget {ring stripe} -corePinTarget {ring stripe} -allowLayerChange 1
CORE_PIN_STOP_ROUTE_STATUS=PASS
MODE_STATUS=PASS
SROUTE_STATUS=PASS
