# MPTDC clk_sys CTS constraint cleanup
INTENT=deidealize_clk_sys_for_measured_cts_without_touching_ro_phase_clocks
RO_PHASE_CLOCKS_REMAIN_PROTECTED=YES
CLK_SYS_ROOT_PRE_CTS_AUDIT=/sim/ksabra/SPADMIC_work/innovus/20260701_mptdc_tc_ro6_cleanlef_dangling_base_route_141308/reports/cts_clk_sys_root_pre_cts_policy.rpt
REMOVE_IDEAL_NETWORK_COMMAND_AVAILABLE=0
CLK_SYS_ROOT_FANOUT_BEFORE=3982
CLK_SYS_CTS_TARGET_FANOUT=64
INTERACTIVE_CONSTRAINT_MODE_STATUS=PASS
INTERACTIVE_CONSTRAINT_MODE=NOMINAL_FUNCTIONAL
INTERACTIVE_CONSTRAINT_MODE_CANDIDATES=NOMINAL_FUNCTIONAL
CLK_SYS_CTS_CLEANUP_COMMAND=set_propagated_clock 0x68af
CLK_SYS_CTS_CLEANUP_STATUS=PASS
CLK_SYS_CTS_FANOUT_PROPERTY_COMMAND=set_ccopt_property max_fanout 64
CLK_SYS_CTS_FANOUT_PROPERTY_STATUS=PASS
CLK_SYS_CTS_FANOUT_PROPERTY_COMMAND=set_ccopt_property cts_max_fanout 64
CLK_SYS_CTS_FANOUT_PROPERTY_STATUS=PASS
CLK_SYS_ROOT_FANOUT_AFTER_CLEANUP=3982
CLK_SYS_ROOT_PRE_CCOPT_AUDIT=/sim/ksabra/SPADMIC_work/innovus/20260701_mptdc_tc_ro6_cleanlef_dangling_base_route_141308/reports/cts_clk_sys_root_pre_ccopt.rpt
