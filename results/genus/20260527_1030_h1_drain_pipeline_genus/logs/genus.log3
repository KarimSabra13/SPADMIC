@file(genus.tcl) 87: if {[llength $tech(LEF_SUPPRESS_MESSAGES_GENUS)] > 0} {
    suppress_messages $tech(LEF_SUPPRESS_MESSAGES_GENUS)
}
@file(genus.tcl) 91: mptdc_message "Loading LEF physical abstracts"
MPTDC_INFO: Loading LEF physical abstracts
@file(genus.tcl) 92: set available_lefs [list]
@file(genus.tcl) 93: foreach lef_file $tech_files(ALL_LEFS) {
    if {[file exists $lef_file]} {
        lappend available_lefs $lef_file
    }
}
@file(genus.tcl) 98: if {[llength $available_lefs] > 0} {
    read_physical -lef $available_lefs
} else {
    mptdc_message "No LEF abstracts found; continuing without physical-aware synthesis" high
}

