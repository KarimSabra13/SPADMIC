           [-user_mean_derate] [-user_sigma_derate] [-incr_derate] [-slew_derate] [-gui] [-max_paths <integer>] [-nworst <integer>] [-logic_levels <integer>] [-skip_buf] [-skip_inv] [-logic_levels_tcl_list]
