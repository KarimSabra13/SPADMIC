digraph G {
      graph [
        rankdir=TB,
        splines=ortho,
        overlap=false,
        newrank=true,
        compound=true,
        nodesep=0.38,
        ranksep=0.68,
        pad=0.18,
        margin=0.08,
        bgcolor="white",
        fontname="Helvetica",
        labelloc=t,
        labeljust=l,
        label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="28"><B>SPADMIC active matrix-top architecture</B></FONT></TD></TR>
      <TR><TD HEIGHT="4"></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Current CSR/I2C, R/Y/B event, correlated packet, matrix configuration, and DDR16 data paths.</FONT></TD></TR>
      <TR><TD HEIGHT="2"></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#475569">TOP/rtl/spadmic_top_matrix_v1.sv + TOP/docs/01_ACTIVE_ARCHITECTURE.md</FONT></TD></TR>
    </TABLE>
    >,
        size="11.69,8.27!"
      ];
      node [fontname="Helvetica"];
      edge [fontname="Helvetica", arrowsize=0.8];
      
    subgraph cluster_chip {
      label="SPADMIC active matrix-top architecture";
      labeljust=l;
      labelloc=t;
      fontsize=18;
      fontcolor="#0F172A";
      color="#1E293B";
      penwidth=2.2;
      style="rounded";

      clock_reset [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#334155" BGCOLOR="#F8FAFC">
      <TR><TD BGCOLOR="#334155" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Clock and reset boundary</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#F8FAFC'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>clk_sys / clk_ref_40m / clk_cfg_40m<BR ALIGN='LEFT'/>async_rst_n<BR ALIGN='LEFT'/>transport-only i2c_rst_i</FONT></TD></TR>
    </TABLE>
    >];
      i2c [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#2563EB" BGCOLOR="#EFF6FF">
      <TR><TD BGCOLOR="#2563EB" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>I2C control plane</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#EFF6FF'><FONT POINT-SIZE='10' COLOR='#475569'>7-bit address 0x42, 16-bit pointer, 32-bit data</FONT></TD></TR><TR><TD ALIGN='LEFT' BGCOLOR='#EFF6FF'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>slave + one-outstanding bridge<BR ALIGN='LEFT'/>CSR router + block-owned banks<BR ALIGN='LEFT'/>fault and counter provenance</FONT></TD></TR>
    </TABLE>
    >];
      analog [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#2563EB" BGCOLOR="#EFF6FF">
      <TR><TD BGCOLOR="#2563EB" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>PLL and analog controls</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#EFF6FF'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>disabled-and-idle writes<BR ALIGN='LEFT'/>documented active polarity<BR ALIGN='LEFT'/>PLL lock status</FONT></TD></TR>
    </TABLE>
    >];

      spad_matrix [shape=box style="rounded,filled,bold" penwidth=2.0 color="#0B0F14" fillcolor="#0B0F14" fontcolor="white" fontname="Helvetica" fontsize=14 width=2.6 height=2.2 label="SPAD MATRIX\nR/Y/B event buses\nRz/Yz/Bz reset selects\n44-column config/readback"];
      snapshot [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#059669" BGCOLOR="#ECFDF5">
      <TR><TD BGCOLOR="#059669" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Snapshot + event coordinator</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#ECFDF5'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>settle/watchdog<BR ALIGN='LEFT'/>one event ID per physical event<BR ALIGN='LEFT'/>frozen packet/reset masks</FONT></TD></TR>
    </TABLE>
    >];
      axis_r [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#7C3AED" BGCOLOR="#F5F3FF">
      <TR><TD BGCOLOR="#7C3AED" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>TDC axis R</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#F5F3FF'><FONT POINT-SIZE='10' COLOR='#475569'>TOP wrapper around protected mptdc_axis_core</FONT></TD></TR><TR><TD ALIGN='LEFT' BGCOLOR='#F5F3FF'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>qualified conversion start<BR ALIGN='LEFT'/>shared tuning<BR ALIGN='LEFT'/>packet pending/ready</FONT></TD></TR>
    </TABLE>
    >];
      axis_y [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#7C3AED" BGCOLOR="#F5F3FF">
      <TR><TD BGCOLOR="#7C3AED" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>TDC axis Y</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#F5F3FF'><FONT POINT-SIZE='10' COLOR='#475569'>TOP wrapper around protected mptdc_axis_core</FONT></TD></TR><TR><TD ALIGN='LEFT' BGCOLOR='#F5F3FF'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>qualified conversion start<BR ALIGN='LEFT'/>shared tuning<BR ALIGN='LEFT'/>packet pending/ready</FONT></TD></TR>
    </TABLE>
    >];
      axis_b [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#7C3AED" BGCOLOR="#F5F3FF">
      <TR><TD BGCOLOR="#7C3AED" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>TDC axis B</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#F5F3FF'><FONT POINT-SIZE='10' COLOR='#475569'>TOP wrapper around protected mptdc_axis_core</FONT></TD></TR><TR><TD ALIGN='LEFT' BGCOLOR='#F5F3FF'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>qualified conversion start<BR ALIGN='LEFT'/>shared tuning<BR ALIGN='LEFT'/>packet pending/ready</FONT></TD></TR>
    </TABLE>
    >];
      position [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#059669" BGCOLOR="#ECFDF5">
      <TR><TD BGCOLOR="#059669" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Position snapshot packetizer</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#ECFDF5'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>cluster/raw mode<BR ALIGN='LEFT'/>gap 2 / minimum span 1 reset defaults<BR ALIGN='LEFT'/>private snapshot before matrix reset</FONT></TD></TR>
    </TABLE>
    >];

      bundle [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#EA580C" BGCOLOR="#FFF7ED">
      <TR><TD BGCOLOR="#EA580C" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Correlated event bundle</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#FFF7ED'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>R then Y then B then position<BR ALIGN='LEFT'/>patch source ID and shared EOC event ID<BR ALIGN='LEFT'/>packet-completion mask</FONT></TD></TR>
    </TABLE>
    >];
      fifo [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#2563EB" BGCOLOR="#EFF6FF">
      <TR><TD BGCOLOR="#2563EB" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Fixed output FIFO</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#EFF6FF'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>fixed reserve threshold<BR ALIGN='LEFT'/>overflow accounting<BR ALIGN='LEFT'/>ordered flush marker</FONT></TD></TR>
    </TABLE>
    >];
      ddr [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#EA580C" BGCOLOR="#FFF7ED">
      <TR><TD BGCOLOR="#EA580C" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>DDR16 pairer</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#FFF7ED'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>two logical 16-bit words per transfer<BR ALIGN='LEFT'/>zero-pad odd final word<BR ALIGN='LEFT'/>ddr_data_l/h + valid + clock</FONT></TD></TR>
    </TABLE>
    >];
      matrix_cfg [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#2563EB" BGCOLOR="#EFF6FF">
      <TR><TD BGCOLOR="#2563EB" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Matrix configuration controller</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#EFF6FF'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>44-column serial commands<BR ALIGN='LEFT'/>64-bit write/readback<BR ALIGN='LEFT'/>clk_cfg_40m domain</FONT></TD></TR>
    </TABLE>
    >];

      { rank=same; clock_reset; i2c; analog; }
      { rank=same; spad_matrix; snapshot; matrix_cfg; }
      { rank=same; axis_r; axis_y; axis_b; position; }
      { rank=same; bundle; fifo; ddr; }

      clock_reset -> i2c [style="invis" weight=20];
      i2c -> analog [style="invis" weight=20];
      spad_matrix -> snapshot [style="invis" weight=20];
      snapshot -> matrix_cfg [style="invis" weight=20];
      axis_r -> axis_y [style="invis" weight=20];
      axis_y -> axis_b [style="invis" weight=20];
      axis_b -> position [style="invis" weight=20];
      bundle -> fifo [style="invis" weight=20];
      fifo -> ddr [style="invis" weight=20];

      clock_reset -> i2c [color="#334155", penwidth=1.6, style="solid", weight=2, xlabel="clk/reset domains", fontsize=10, fontcolor="#334155"];
      clock_reset -> snapshot [color="#334155", penwidth=1.6, style="solid", weight=2];
      clock_reset -> matrix_cfg [color="#334155", penwidth=1.6, style="solid", weight=2];
      i2c -> analog [color="#2563EB", penwidth=1.6, style="solid", weight=2, xlabel="CSR controls", fontsize=10, fontcolor="#334155"];
      i2c -> snapshot [color="#2563EB", penwidth=1.6, style="solid", weight=2, xlabel="mode + event config", fontsize=10, fontcolor="#334155"];
      i2c -> matrix_cfg [color="#2563EB", penwidth=1.6, style="solid", weight=2, xlabel="matrix commands", fontsize=10, fontcolor="#334155"];
      spad_matrix -> snapshot [color="#059669", penwidth=1.6, style="solid", weight=2, xlabel="R/Y/B snapshot", fontsize=10, fontcolor="#334155"];
      snapshot -> axis_r [color="#7C3AED", penwidth=1.6, style="solid", weight=2, xlabel="event R", fontsize=10, fontcolor="#334155"];
      snapshot -> axis_y [color="#7C3AED", penwidth=1.6, style="solid", weight=2, xlabel="event Y", fontsize=10, fontcolor="#334155"];
      snapshot -> axis_b [color="#7C3AED", penwidth=1.6, style="solid", weight=2, xlabel="event B", fontsize=10, fontcolor="#334155"];
      snapshot -> position [color="#059669", penwidth=1.6, style="solid", weight=2, xlabel="captured R/Y/B", fontsize=10, fontcolor="#334155"];
      axis_r -> bundle [color="#7C3AED", penwidth=1.6, style="solid", weight=2, xlabel="R packet", fontsize=10, fontcolor="#334155"];
      axis_y -> bundle [color="#7C3AED", penwidth=1.6, style="solid", weight=2, xlabel="Y packet", fontsize=10, fontcolor="#334155"];
      axis_b -> bundle [color="#7C3AED", penwidth=1.6, style="solid", weight=2, xlabel="B packet", fontsize=10, fontcolor="#334155"];
      position -> bundle [color="#059669", penwidth=1.6, style="solid", weight=2, xlabel="position packet", fontsize=10, fontcolor="#334155"];
      bundle -> fifo [color="#EA580C", penwidth=1.6, style="solid", weight=2, xlabel="16-bit words + flush", fontsize=10, fontcolor="#334155"];
      fifo -> ddr [color="#EA580C", penwidth=1.6, style="solid", weight=2, xlabel="logical word stream", fontsize=10, fontcolor="#334155"];
      matrix_cfg -> spad_matrix [color="#2563EB", penwidth=1.6, style="solid", weight=2, xlabel="DIN/CIN and DOUT/COUT", fontsize=10, fontcolor="#334155"];
    }

    top_note [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#CA8A04" BGCOLOR="#FEF3C7">
      <TR><TD BGCOLOR="#CA8A04" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Technical note</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#FEF3C7'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>The external matrix-top port list is preserved by the CSR ABI 1.0 integration.<BR ALIGN='LEFT'/>MPTDC/rtl/top/mptdc_axis_core.sv remains a protected implementation boundary.<BR ALIGN='LEFT'/>RTL verification does not authorize Genus, Innovus, OA edits, or signoff.</FONT></TD></TR>
    </TABLE>
    >];
    { rank=same; top_note; }
    
    }