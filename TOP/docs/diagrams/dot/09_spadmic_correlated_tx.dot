digraph G {
      graph [
        rankdir=TB,
        splines=ortho,
        overlap=false,
        newrank=true,
        compound=true,
        nodesep=0.38,
        ranksep=0.68,
        pad=0.18,
        margin=0.08,
        bgcolor="white",
        fontname="Helvetica",
        labelloc=t,
        labeljust=l,
        label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="28"><B>spadmic_correlated_tx</B></FONT></TD></TR>
      <TR><TD HEIGHT="4"></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Unified four-source ARB with per-axis TDC adapters, packet locks, event tagging, and a 256-word output FIFO.</FONT></TD></TR>
      <TR><TD HEIGHT="2"></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#475569">arb/rtl/spadmic_correlated_tx.sv</FONT></TD></TR>
    </TABLE>
    >,
        size="11.69,8.27!"
      ];
      node [fontname="Helvetica"];
      edge [fontname="Helvetica", arrowsize=0.8];
      
    tdc_inputs [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#7C3AED" BGCOLOR="#F5F3FF">
      <TR><TD BGCOLOR="#7C3AED" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>3 acquisition-record inputs</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#F5F3FF'><FONT FACE='DejaVu Sans Mono' POINT-SIZE='10'>acq_valid_i[2:0]<BR ALIGN='LEFT'/>ACQ_REC_META / ACQ_REC_HIT<BR ALIGN='LEFT'/>RAW_FEATURES or FULL only</FONT></TD></TR>
    </TABLE>
    >];
    adapters [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#7C3AED" BGCOLOR="#F5F3FF">
      <TR><TD BGCOLOR="#7C3AED" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>TDC packet adapters x3</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#F5F3FF'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>HEADER<BR ALIGN='LEFT'/>HIT W0/W1(/W2)<BR ALIGN='LEFT'/>EOC placeholder</FONT></TD></TR>
    </TABLE>
    >];
    pos [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#059669" BGCOLOR="#ECFDF5">
      <TR><TD BGCOLOR="#059669" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Position packet sideband adapter</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#ECFDF5'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>cluster fixed 8 words<BR ALIGN='LEFT'/>raw fixed 14 words<BR ALIGN='LEFT'/>SOP/EOP/source sidebands</FONT></TD></TR>
    </TABLE>
    >];
    mask [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#2563EB" BGCOLOR="#EFF6FF">
      <TR><TD BGCOLOR="#2563EB" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Registered source masks</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#EFF6FF'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>axis_enable<BR ALIGN='LEFT'/>position_enable<BR ALIGN='LEFT'/>RAW_TIMESTAMP masked</FONT></TD></TR>
    </TABLE>
    >];
    arb [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#EA580C" BGCOLOR="#FFF7ED">
      <TR><TD BGCOLOR="#EA580C" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>4-way packet arbiter</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#FFF7ED'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>source skids<BR ALIGN='LEFT'/>registered grant<BR ALIGN='LEFT'/>lock until EOP</FONT></TD></TR>
    </TABLE>
    >];
    tag [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#EA580C" BGCOLOR="#FFF7ED">
      <TR><TD BGCOLOR="#EA580C" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Unified event tag patch</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#FFF7ED'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>single 14-bit rolling tag<BR ALIGN='LEFT'/>overwrite producer EOC<BR ALIGN='LEFT'/>increment on FIFO write EOP</FONT></TD></TR>
    </TABLE>
    >];
    fifo [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#2563EB" BGCOLOR="#EFF6FF">
      <TR><TD BGCOLOR="#2563EB" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Output FIFO</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#EFF6FF'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>256 words<BR ALIGN='LEFT'/>155-word max burst + margin<BR ALIGN='LEFT'/>DDR always-ready baseline</FONT></TD></TR>
    </TABLE>
    >];

    { rank=same; tdc_inputs; adapters; arb; tag; fifo; }
    { rank=same; pos; mask; }

    tdc_inputs -> adapters [style="invis" weight=20];
    adapters -> arb [style="invis" weight=20];
    arb -> tag [style="invis" weight=20];
    tag -> fifo [style="invis" weight=20];

    tdc_inputs -> adapters [color="#7C3AED", penwidth=1.6, style="solid", weight=2, xlabel="per-axis records", fontsize=10, fontcolor="#334155"];
    adapters -> arb [color="#7C3AED", penwidth=1.6, style="solid", weight=2, xlabel="TDC_X/Y/Z packet streams", fontsize=10, fontcolor="#334155"];
    pos -> arb [color="#059669", penwidth=1.6, style="solid", weight=2, xlabel="position packet stream", fontsize=10, fontcolor="#334155"];
    mask -> arb [color="#2563EB", penwidth=1.6, style="solid", weight=2, xlabel="enabled sources", fontsize=10, fontcolor="#334155"];
    arb -> tag [color="#EA580C", penwidth=1.6, style="solid", weight=2, xlabel="packet-atomic words", fontsize=10, fontcolor="#334155"];
    tag -> fifo [color="#EA580C", penwidth=1.6, style="solid", weight=2, xlabel="tagged logical stream", fontsize=10, fontcolor="#334155"];
    
    }