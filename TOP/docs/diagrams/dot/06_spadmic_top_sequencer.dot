digraph G {
      graph [
        rankdir=TB,
        splines=ortho,
        overlap=false,
        newrank=true,
        compound=true,
        nodesep=0.38,
        ranksep=0.68,
        pad=0.18,
        margin=0.08,
        bgcolor="white",
        fontname="Helvetica",
        labelloc=t,
        labeljust=l,
        label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="28"><B>spadmic_top_sequencer</B></FONT></TD></TR>
      <TR><TD HEIGHT="4"></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Drain-aware requested-to-active handoff that keeps mode/source changes packet-safe.</FONT></TD></TR>
      <TR><TD HEIGHT="2"></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#475569">TOP/rtl/spadmic_top_sequencer.sv</FONT></TD></TR>
    </TABLE>
    >,
        size="11.69,8.27!"
      ];
      node [fontname="Helvetica"];
      edge [fontname="Helvetica", arrowsize=0.8];
      
    req_img [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#2563EB" BGCOLOR="#EFF6FF">
      <TR><TD BGCOLOR="#2563EB" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Requested image inputs</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#EFF6FF'><FONT FACE='DejaVu Sans Mono' POINT-SIZE='10'>cfg_update_i<BR ALIGN='LEFT'/>req_global_enable_i<BR ALIGN='LEFT'/>req_axis_enable_i<BR ALIGN='LEFT'/>req_position_enable_i<BR ALIGN='LEFT'/>req_shared_tx_sel_i<BR ALIGN='LEFT'/>req_tdc_input_sel_i / req_tdc_out_mode_i</FONT></TD></TR>
    </TABLE>
    >];
    path_state [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#334155" BGCOLOR="#F8FAFC">
      <TR><TD BGCOLOR="#334155" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Drain-status inputs</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#F8FAFC'><FONT FACE='DejaVu Sans Mono' POINT-SIZE='10'>tdc_tx_busy_i<BR ALIGN='LEFT'/>tdc_pkt_pending_i[2:0]<BR ALIGN='LEFT'/>position_busy_i<BR ALIGN='LEFT'/>position_pending_i</FONT></TD></TR>
    </TABLE>
    >];
    reset_s [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#334155" BGCOLOR="#F8FAFC">
      <TR><TD BGCOLOR="#334155" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>SEQ_RESET</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#F8FAFC'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>active image disabled<BR ALIGN='LEFT'/>wait path_idle</FONT></TD></TR>
    </TABLE>
    >];
    idle_s [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#2563EB" BGCOLOR="#EFF6FF">
      <TR><TD BGCOLOR="#2563EB" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>SEQ_IDLE</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#EFF6FF'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>cfg_accept_o only if path_idle<BR ALIGN='LEFT'/>wait cfg_update_i</FONT></TD></TR>
    </TABLE>
    >];
    drain_s [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#EA580C" BGCOLOR="#FFF7ED">
      <TR><TD BGCOLOR="#EA580C" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>SEQ_DRAIN</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#FFF7ED'><FONT FACE='DejaVu Sans' POINT-SIZE='10'>force active_global_enable_o low<BR ALIGN='LEFT'/>drain old path<BR ALIGN='LEFT'/>copy req_* -&gt; active_* when idle</FONT></TD></TR>
    </TABLE>
    >];
    active_img [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#2563EB" BGCOLOR="#EFF6FF">
      <TR><TD BGCOLOR="#2563EB" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Active image outputs</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#EFF6FF'><FONT FACE='DejaVu Sans Mono' POINT-SIZE='10'>active_global_enable_o<BR ALIGN='LEFT'/>active_axis_enable_o<BR ALIGN='LEFT'/>active_position_enable_o<BR ALIGN='LEFT'/>active_shared_tx_sel_o<BR ALIGN='LEFT'/>active_tdc_input_sel_o / active_tdc_out_mode_o</FONT></TD></TR>
    </TABLE>
    >];
    status [shape=plain margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#EA580C" BGCOLOR="#FFF7ED">
      <TR><TD BGCOLOR="#EA580C" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Status outputs</B></FONT></TD></TR>
      <TR><TD ALIGN='LEFT' BGCOLOR='#FFF7ED'><FONT FACE='DejaVu Sans Mono' POINT-SIZE='10'>cfg_accept_o<BR ALIGN='LEFT'/>transition_busy_o</FONT></TD></TR>
    </TABLE>
    >];

    { rank=same; req_img; reset_s; idle_s; drain_s; active_img; }
    { rank=same; path_state; status; }

    req_img -> reset_s [style="invis" weight=20];
    reset_s -> idle_s [style="invis" weight=20];
    idle_s -> drain_s [style="invis" weight=20];
    drain_s -> active_img [style="invis" weight=20];

    req_img -> idle_s [color="#2563EB", penwidth=1.6, style="solid", weight=2, xlabel="cfg_update_i", fontsize=10, fontcolor="#334155"];
    path_state -> reset_s [color="#334155", penwidth=1.6, style="solid", weight=2, xlabel="path_idle", fontsize=10, fontcolor="#334155"];
    path_state -> idle_s [color="#334155", penwidth=1.6, style="solid", weight=2];
    path_state -> drain_s [color="#334155", penwidth=1.6, style="solid", weight=2];
    drain_s -> active_img [color="#2563EB", penwidth=1.6, style="solid", weight=2, xlabel="commit active_*", fontsize=10, fontcolor="#334155"];
    idle_s -> status [color="#EA580C", penwidth=1.6, style="solid", weight=2, xlabel="cfg_accept_o", fontsize=10, fontcolor="#334155"];
    drain_s -> status [color="#EA580C", penwidth=1.6, style="solid", weight=2, xlabel="transition_busy_o", fontsize=10, fontcolor="#334155"];
    
    }