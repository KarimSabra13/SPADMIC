\addvspace {10\p@ }
\contentsline {figure}{\numberline {1.1}{\ignorespaces Vue d'ensemble simplifiée du prototype \textbf {SPADMIC} et de la place du cœur \textbf {MPTDC} dans la chaîne de lecture.}}{2}{figure.caption.7}%
\addvspace {10\p@ }
\addvspace {10\p@ }
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Architecture de lecture de \textbf {SPADMIC}. Les projections de la matrice alimentent en parallèle le chemin temporel \textbf {MPTDC} et le chemin spatial de position ; le contrôleur supérieur choisit ensuite le mode d'export vers le flux \textbf {TX} partagé.}}{9}{figure.caption.8}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Schéma de synthèse d'une chaîne de mesure temporelle, du détecteur au codage binaire.}}{12}{figure.caption.9}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {6.1}{\ignorespaces Schéma temporel de synthèse du principe Vernier détaillé. Le rattrapage progressif du chemin rapide structure la mesure grossière, tandis que l'observation multiphase raffine la position de la première coïncidence dans l'intervalle $T_{\mathrm {LSB}}$.}}{18}{figure.caption.11}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Schéma de synthèse de l'architecture Vernier multiphase de référence, inspiré des principes décrits dans la thèse \blx@tocontentsinit {0}\cite {annagrebah2021thesis}.}}{19}{figure.caption.12}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Chronogramme simplifié du fonctionnement Vernier multiphase. Le schéma est volontairement réduit à cinq phases lentes et cinq phases rapides afin de rendre lisible l'observation parallèle de plusieurs couples de phase.}}{20}{figure.caption.13}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Carte de la matrice \mbox {$8\times 8$} des détecteurs de phase. Chaque cellule correspond à une paire $(n_s,n_f)$ et à un coefficient fin nominal associé.}}{21}{figure.caption.14}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {7.1}{\ignorespaces Transition matérielle entre l'architecture Vernier de référence et l'implémentation active \textbf {MPTDC}. Le style reprend celui du modèle de référence afin de rendre visibles les briques conservées, modifiées et ajoutées.}}{24}{figure.caption.15}%
\contentsline {figure}{\numberline {7.2}{\ignorespaces Carte des domaines temporels et des frontières CDC dans l'architecture active. Les traversées représentées transportent des commandes compactes, des compteurs Gray ou des images figées, et non des phases analogiques en évolution continue.}}{25}{figure.caption.16}%
\contentsline {figure}{\numberline {7.3}{\ignorespaces Capture asynchrone des événements. Les fronts \texttt {START}/\texttt {STOP} arment directement les verrous et les anneaux ; \texttt {clk\_sys} intervient ensuite pour protéger puis nettoyer la fenêtre de mesure.}}{26}{figure.caption.18}%
\contentsline {figure}{\numberline {7.4}{\ignorespaces Pipeline à deux contextes. Le snapshot protège la mesure terminée, puis le drain et la sérialisation d'un contexte peuvent se recouvrir avec la capture du contexte suivant.}}{26}{figure.caption.19}%
\contentsline {figure}{\numberline {7.5}{\ignorespaces Flux de sortie et calibration externe. L'ASIC exporte une trame compacte contenant les observables de mesure et les informations auxiliaires utiles ; le décodage et la correction par LUT restent réalisés hors circuit.}}{27}{figure.caption.20}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {8.1}{\ignorespaces Vue fonctionnelle du cœur MPTDC. Les événements arment les oscillateurs ; les faisceaux de phases alimentent la matrice Vernier ; le domaine système récupère ensuite des compteurs synchronisés, une image de mesure figée et un flux de lecture compact.}}{29}{figure.caption.22}%
\contentsline {figure}{\numberline {8.2}{\ignorespaces Protocole de fermeture d'une mesure. La FSM système observe la fin de conversion, fige l'image de la matrice, écrit le contexte, nettoie la fenêtre de détection puis autorise la lecture.}}{30}{figure.caption.24}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {9.1}{\ignorespaces Effet de la calibration externe sur la distribution d'erreur. La LUT supprime le biais principal et concentre l'erreur corrigée autour de zéro.}}{34}{figure.caption.26}%
\contentsline {figure}{\numberline {9.2}{\ignorespaces DNL/INL observables sur les codes atteints. La métrique décrit les codes effectivement vus par la campagne ; elle ne prétend pas remplir uniformément tous les emplacements de la grille brute.}}{35}{figure.caption.27}%
\contentsline {figure}{\numberline {9.3}{\ignorespaces Évolution de l'erreur avec le moyennage statistique après LUT, bornée au domaine $N \leq 64$.}}{36}{figure.caption.29}%
\addvspace {10\p@ }
